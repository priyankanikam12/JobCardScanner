# mobile\.env.example - copy to .env and fill in real values
EXPO_PUBLIC_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_AZURE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# USB tethering: use localhost with adb reverse tcp:5262 tcp:5262
EXPO_PUBLIC_API_BASE_URL=http://localhost:5262
# BGauss Care Desk address, no slash at the end (empty = Care Desk is not set up in this build)
EXPO_PUBLIC_CARE_DESK_URL=
