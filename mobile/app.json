{
  "expo": {
    "name": "JobCardScanner",
    "slug": "jobcardscanner",
    "scheme": "jobcardscanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/BG_Logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bgauss.jobcardscanner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bgauss.jobcardscanner",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/BG_Logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JobCardScanner needs access to your photos so you can attach vehicle photos to a job card.",
          "cameraPermission": "JobCardScanner needs access to your camera so you can take vehicle photos for a job card."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "JobCardScanner uses your location to tag where a job card photo was taken."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser"
    ],
    "owner": "priyankanikam101ss-team",
    "extra": {
      "eas": {
        "projectId": "222321e0-98ff-4f60-bbf4-35737f0d296a"
      }
    }
  }
}
